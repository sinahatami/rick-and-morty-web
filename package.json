{
  "name": "rick-and-morty-web",
  "version": "1.0.0",
  "private": true,
  "description": "Explorer for the Rick and Morty universe: characters, locations and episodes.",
  "homepage": "https://sinahatami.github.io/rick-and-morty-web",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinahatami/rick-and-morty-web.git"
  },
  "author": "Sina Hatami",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "data": "node scripts/fetch-api-data.mjs",
    "dev": "node scripts/fetch-api-data.mjs && next dev",
    "build": "node scripts/fetch-api-data.mjs && next build",
    "start": "serve out --listen 3000 --no-clipboard",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "knip": "knip",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "verify": "pnpm check && pnpm build && pnpm e2e",
    "lhci": "lhci autorun",
    "release": "semantic-release",
    "deploy:pages": "gh-pages --dist out --dotfiles --no-history",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@tanstack/react-query": "^5.108.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.80.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "knip": "^6.48.0",
    "lint-staged": "^17.6.2",
    "postcss": "^8.5.6",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "semantic-release": "^26.0.1",
    "serve": "^14.2.8",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
